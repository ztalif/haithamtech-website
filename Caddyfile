# Caddyfile — Haitham Tech (SPEC §10)
# Dipakai oleh service `site` di docker-compose.yml.
#
# Caddy berjalan DI BELAKANG Traefik milik stack n8n (VPS dipakai bersama —
# lihat decisions.md 2026-10-07). Traefik yang memegang port 80/443 dan
# sertifikat TLS; Caddy hanya menerima HTTP polos dari Traefik di network
# `proxy`. Karena itu HTTPS otomatis Caddy dimatikan dan setiap site address
# diawali `http://`.

{
	auto_https off
}

# Redirect www → non-www: canonical tunggal, hindari duplicate content (SPEC §8).
# Target sengaja https: canonical situs selalu https. Sebelum Fase B (domain +
# TLS) aktif, redirect ini memang menuju alamat yang belum hidup.
http://www.haithamtech.com {
	redir https://haithamtech.com{uri} permanent
}

http://haithamtech.com {
	# Isi dist/ hasil rsync dari deploy.yml (DEPLOY_PATH). Bind-mount read-only di compose.
	root * /srv/site

	encode gzip zstd

	# WAJIB (decisions.md 2026-08-23): Astro meng-emit `artikel/index.html`, sementara
	# seluruh link internal & canonical memakai `/artikel` (trailingSlash: 'never').
	# Tanpa ini file_server menjawab 301 → `/artikel/`, dan URL tayang ≠ canonical.
	try_files {path} {path}/index.html

	file_server

	# Halaman 404 on-brand (SPEC §5.6). Astro meng-emit dist/404.html sebagai file.
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
