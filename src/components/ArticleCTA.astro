---
/**
 * CTA wajib di akhir setiap artikel (SPEC §5.3).
 *
 * Dua jalur konversi: ke halaman Layanan (pengunjung yang masih menimbang)
 * dan chat langsung (yang sudah siap bertanya). Menghormati flag HAS_* dari
 * consts.ts — selama nomor WA belum diisi, tombolnya mengarah ke /kontak
 * lewat `whatsappLink()` dan labelnya tidak menjanjikan WhatsApp.
 */
import { whatsappLink, WHATSAPP_CTA_LABEL } from '../consts';

interface Props {
  /** Pesan pra-isi WhatsApp, bisa disesuaikan per konteks artikel. */
  message?: string;
}

const { message } = Astro.props;
---

<aside
  class="mt-16 rounded-2xl border border-line bg-surface-soft px-6 py-8 sm:px-8"
  aria-labelledby="cta-artikel"
>
  <h2 id="cta-artikel" class="text-xl font-bold text-ink">
    Mau CS bisnis Anda jalan otomatis 24/7?
  </h2>
  <p class="mt-3 max-w-prose text-ink-soft">
    Kami membangun AI Customer Service Agent yang paham produk Anda, menjawab
    pelanggan kapan pun, dan tetap bisa dialihkan ke manusia saat memang perlu.
  </p>
  <div class="mt-6 flex flex-wrap gap-3">
    <a
      href={whatsappLink(message)}
      rel="noopener"
      class="inline-block rounded-full bg-primary px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
    >
      {WHATSAPP_CTA_LABEL}
    </a>
    <a
      href="/layanan"
      class="inline-block rounded-full border border-line bg-surface px-5 py-3 text-sm font-semibold text-ink transition-colors hover:border-primary hover:text-primary"
    >
      Lihat paket layanan
    </a>
  </div>
</aside>
