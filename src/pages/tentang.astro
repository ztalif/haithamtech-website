---
// Placeholder — isi sesungguhnya dibangun di sesi tersendiri (SPEC §5.4).
// Halaman ini sudah ada sekarang agar navigasi Header/Footer tidak menunjuk
// ke link mati (gerbang `npm run linkcheck`).
import BaseLayout from '../layouts/BaseLayout.astro';
import { whatsappLink, WHATSAPP_CTA_LABEL } from '../consts';
---

<BaseLayout title="Tentang" description="Mengenal Haitham Tech — siapa di balik layanan AI Customer Service Agent untuk bisnis Indonesia dan apa misinya.">
  <div class="mx-auto max-w-2xl px-6 py-24">
    <h1 class="text-3xl font-bold text-ink sm:text-4xl">Tentang</h1>
    <p class="mt-4 text-ink-soft">Halaman ini sedang kami tulis. Singkatnya: Haitham Tech membantu bisnis Indonesia mengotomatiskan layanan pelanggan tanpa kehilangan sentuhan manusia.</p>
    <p class="mt-8">
      <a
        href={whatsappLink()}
        rel="noopener"
        class="inline-block rounded-full bg-primary px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
      >
        {WHATSAPP_CTA_LABEL}
      </a>
    </p>
  </div>
</BaseLayout>
