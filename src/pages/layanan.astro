---
/**
 * Halaman Layanan (SPEC §5.2) — disusun dari section modular di src/sections/.
 *
 * JSON-LD `Service` per paket disuntik lewat slot "head" BaseLayout (SPEC §8).
 * Sengaja TANPA `offers`/`price`: harga paket belum ditetapkan, dan JSON-LD
 * adalah klaim terstruktur ke mesin pencari — mengisinya dengan angka karangan
 * melanggar SPEC §2.8. Saat harga sudah ada, tambahkan `offers` di sini.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LayananHero from '../sections/LayananHero.astro';
import PaketBasic from '../sections/PaketBasic.astro';
import PaketBusiness from '../sections/PaketBusiness.astro';
import ClosingCTA from '../sections/ClosingCTA.astro';
import { SITE_NAME, SITE_URL, AREA_SERVED } from '../consts';

const provider = {
  '@type': 'ProfessionalService',
  name: SITE_NAME,
  url: SITE_URL,
};

const services = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Paket Basic — AI Customer Service Agent',
    serviceType: 'AI Customer Service Agent',
    description:
      'Agent AI yang membalas pertanyaan pelanggan secara otomatis 24/7, dilatih dari informasi produk, jasa, dan SOP layanan pelanggan Anda.',
    url: `${SITE_URL}/layanan#basic`,
    provider,
    areaServed: AREA_SERVED,
    availableLanguage: 'id',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Paket Business — AI Customer Service Agent',
    serviceType: 'AI Customer Service Agent',
    description:
      'Seluruh kemampuan Paket Basic ditambah kategorisasi pelanggan otomatis, database pelanggan terstruktur di Google Sheets, analitik dasar, dan eskalasi cerdas ke CS manusia via email.',
    url: `${SITE_URL}/layanan#business`,
    provider,
    areaServed: AREA_SERVED,
    availableLanguage: 'id',
  },
];
---

<BaseLayout
  title="Layanan"
  description="Paket AI Customer Service Agent dari Haitham Tech: Basic untuk usaha rintisan dan Business dengan kategorisasi pelanggan, analitik, serta eskalasi ke CS manusia."
>
  <Fragment slot="head">
    {
      services.map((service) => (
        <script type="application/ld+json" set:html={JSON.stringify(service)} />
      ))
    }
  </Fragment>

  <LayananHero />
  <PaketBasic />
  <PaketBusiness />
  <ClosingCTA />
</BaseLayout>
