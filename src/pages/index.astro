---
// Halaman sementara hasil scaffold — Beranda sesungguhnya (Hero, social proof, fitur,
// cara kerja, CTA penutup) dibangun di sesi berikutnya sesuai SPEC §5.1,
// setelah BaseLayout + head SEO tersedia.
import '../styles/global.css';
import { SITE_NAME, SITE_TAGLINE } from '../consts';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_NAME} — {SITE_TAGLINE}</title>
  </head>
  <body class="bg-surface-soft">
    <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center px-6">
      <p class="text-sm font-medium tracking-wide text-primary">{SITE_TAGLINE}</p>
      <h1 class="mt-2 text-4xl font-bold text-ink">{SITE_NAME}</h1>
      <p class="mt-4 text-ink-soft">
        Situs sedang dibangun. Fondasi proyek (Astro, Tailwind v4, TypeScript) sudah siap.
      </p>
    </main>
  </body>
</html>
