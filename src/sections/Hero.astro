---
/**
 * Hero Beranda (SPEC §5.1.1): value proposition + CTA utama + chat preview.
 *
 * Chat preview murni HTML/CSS — tidak ada backend dan tidak ada JS (SPEC §2.2).
 * Indikator "sedang mengetik" dianimasikan lewat @keyframes di bawah, bukan
 * script, dan dimatikan saat pengunjung meminta gerak minimal.
 */
import { whatsappLink, WHATSAPP_CTA_LABEL } from '../consts';

// Percakapan contoh. Sengaja generik (toko online) supaya relevan untuk
// mayoritas audiens dan tidak menyiratkan klien nyata tertentu.
const chat = [
  { from: 'pelanggan', text: 'Halo, stok sepatu running ukuran 42 masih ada?' },
  {
    from: 'agent',
    text: 'Halo! Masih ada, Kak 👋 Ukuran 42 tersedia warna hitam dan abu. Mau saya kirimkan fotonya?',
  },
  { from: 'pelanggan', text: 'Boleh. Kalau pesan sekarang sampai kapan ya?' },
  {
    from: 'agent',
    text: 'Pesanan sebelum jam 3 sore dikirim hari ini juga, estimasi tiba 1–2 hari kerja.',
  },
] as const;
---

<section class="border-b border-line bg-surface-soft">
  <div
    class="mx-auto grid max-w-5xl gap-12 px-6 py-16 sm:py-20 lg:grid-cols-2 lg:items-center lg:gap-16"
  >
    <div>
      <p class="text-sm font-semibold tracking-wide text-primary uppercase">
        AI Customer Service Agent
      </p>
      <h1
        class="mt-3 text-3xl leading-tight font-bold text-balance text-ink sm:text-4xl lg:text-5xl"
      >
        Pelanggan Anda dibalas dalam hitungan detik, jam berapa pun
      </h1>
      <p class="mt-5 max-w-prose text-base text-ink-soft sm:text-lg">
        Haitham Tech membangun AI Customer Service Agent yang paham produk dan
        SOP bisnis Anda — menjawab pertanyaan berulang secara otomatis di
        WhatsApp, dan menyerahkan obrolan ke tim manusia saat memang perlu.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={whatsappLink()}
          rel="noopener"
          class="inline-block rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
        >
          {WHATSAPP_CTA_LABEL}
        </a>
        <a
          href="/layanan"
          class="inline-block rounded-full border border-line bg-surface px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-primary hover:text-primary"
        >
          Lihat paket layanan
        </a>
      </div>

      <p class="mt-4 text-sm text-ink-soft">
        Konsultasi awal gratis — kami bantu petakan dulu apakah CS Anda memang
        cocok diotomatiskan.
      </p>
    </div>

    <!-- Chat preview: dekoratif, jadi disembunyikan dari pembaca layar supaya
         percakapan contoh tidak dibacakan sebagai konten halaman. -->
    <div class="chat-preview" aria-hidden="true">
      <div
        class="mx-auto w-full max-w-sm rounded-3xl border border-line bg-surface p-4 shadow-sm"
      >
        <div class="flex items-center gap-3 border-b border-line pb-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-sm font-bold text-white"
          >
            HT
          </span>
          <span>
            <span class="block text-sm font-semibold text-ink">
              Haitham Tech CS
            </span>
            <span class="block text-xs text-primary">online</span>
          </span>
        </div>

        <div class="space-y-3 pt-4">
          {
            chat.map((bubble) => (
              <div
                class:list={[
                  'flex',
                  bubble.from === 'agent' ? 'justify-start' : 'justify-end',
                ]}
              >
                <p
                  class:list={[
                    'max-w-[85%] rounded-2xl px-4 py-2 text-sm leading-relaxed',
                    bubble.from === 'agent'
                      ? 'rounded-bl-sm bg-surface-soft text-ink'
                      : 'rounded-br-sm bg-primary text-white',
                  ]}
                >
                  {bubble.text}
                </p>
              </div>
            ))
          }

          <div class="flex justify-start">
            <span
              class="typing flex items-center gap-1 rounded-2xl rounded-bl-sm bg-surface-soft px-4 py-3"
            >
              <span class="dot"></span>
              <span class="dot"></span>
              <span class="dot"></span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .chat-preview .dot {
    display: block;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background-color: var(--color-ink-soft);
    opacity: 0.4;
    animation: typing-bounce 1.2s infinite ease-in-out;
  }

  .chat-preview .dot:nth-child(2) {
    animation-delay: 0.15s;
  }

  .chat-preview .dot:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes typing-bounce {
    0%,
    60%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-0.2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-preview .dot {
      animation: none;
    }
  }
</style>
